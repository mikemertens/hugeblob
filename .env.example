# Required
ANTHROPIC_API_KEY=sk-ant-...

# Required for embeddings (or set EMBEDDING_PROVIDER=ollama to use local)
OPENAI_API_KEY=sk-...

# Required for Readwise highlights sync
READWISE_API_KEY=...

# Path to your EPUB/PDF files directory
BOOKS_DIR=~/Books

# Embedding provider: "openai" (default) or "ollama"
EMBEDDING_PROVIDER=openai

# Ollama base URL (only needed if EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant (defaults work if you use docker-compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Claude model to use for Q&A
CLAUDE_MODEL=claude-sonnet-4-6

# Chunking tuning
CHUNK_SIZE=400
CHUNK_OVERLAP=50
