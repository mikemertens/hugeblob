# Required
ANTHROPIC_API_KEY=sk-ant-...

# Required for embeddings if EMBEDDING_PROVIDER=openai (the default)
OPENAI_API_KEY=sk-...

# Required for embeddings if EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-...

# Required for Readwise highlights sync
READWISE_API_KEY=...

# Path to your EPUB/PDF files directory
BOOKS_DIR=~/Books

# Embedding provider: "openai" (default) | "voyage" | "ollama"
EMBEDDING_PROVIDER=openai

# IMPORTANT: EMBEDDING_DIM must match your provider/model, and you cannot
# mix providers in one Qdrant collection. If you switch providers, also
# change EMBEDDING_DIM and re-ingest into a fresh collection.
#   openai text-embedding-3-small -> 1536
#   voyage voyage-3               -> 1024  (voyage-3-lite -> 512)
#   ollama nomic-embed-text       -> 768
EMBEDDING_DIM=1536

# Ollama base URL (only needed if EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant (defaults work if you use docker-compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Claude model to use for Q&A
CLAUDE_MODEL=claude-sonnet-4-6

# Chunking tuning
CHUNK_SIZE=400
CHUNK_OVERLAP=50
